# Supabase project credentials (Project Settings > API)
# The anon/public key is safe for the frontend — never put the service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: only used for the admin login screen when Supabase Auth has not
# been configured yet, so you can preview the admin dashboard locally.
# Leave unset in production — real deployments should rely on Supabase Auth
# (see README "Admin authentication" section).
VITE_ADMIN_DEMO_PASSWORD=
